DJANGO_SECRET_KEY=replace-with-a-random-secret-at-least-50-characters
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
FRONTEND_URL=http://localhost:5173

# Leave DATABASE_URL empty to use SQLite at backend/db.sqlite3.
# For production, configure PostgreSQL:
# DATABASE_URL=postgresql://postgres:your_password@localhost:5432/vedhika_brand
DATABASE_URL=
DATABASE_SSLMODE=prefer

# Optional: set this to use Google Maps instead of the default no-key OSM/OSRM service.
GOOGLE_MAPS_API_KEY=
DELIVERY_STORE_ADDRESS="Door No. 4/77/A, Happy Down, Salaiyar, Nandhavanapatty, Old Karur Road, Dindigul - 624 005, India"
DELIVERY_STORE_FALLBACK_ADDRESS="Dindigul 624005, Tamil Nadu, India"

# Optional SMTP settings. In development, password reset emails print to the terminal.
EMAIL_BACKEND=
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
DEFAULT_FROM_EMAIL=VEDHIKA BRAND <no-reply@example.invalid>
